# ==============================================================================
# Ravi Dasari — Premium Dynamic Personal Portfolio
# Environment Variables & Secrets Reference Blueprint
# ==============================================================================
# NOTE: This file is a template and reference guide.
# NEVER commit real secret keys, private credentials, or live tokens to git.
# In Cloudflare Workers, sensitive secrets are set using:
#   npx wrangler secret put <SECRET_NAME>
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE BUILD VARIABLES (Injected into Vite SPA bundle)
# ------------------------------------------------------------------------------
# Set in vite.config.ts or .env for local preview.
# Note: DO NOT put any sensitive secrets in VITE_* variables.
VITE_SITE_TITLE="Ravi Dasari — Senior DevOps & Cloud Infrastructure Engineer"
VITE_API_BASE_URL="/api"

# ------------------------------------------------------------------------------
# 2. WORKER RUNTIME VARIABLES (Configured in wrangler.toml [vars])
# ------------------------------------------------------------------------------
# These are non-sensitive configuration values exposed to the Edge Worker.
ENVIRONMENT="production"                                    # "production" | "development"
PUBLIC_DOMAIN="ravi-portfolio.dsecops88.online"              # Planned custom domain
CF_ACCESS_TEAM_DOMAIN="https://dsecops88.cloudflareaccess.com" # Cloudflare Access team domain
CF_ACCESS_OWNER_EMAIL="dasariravid145@gmail.com"             # Verified owner email allowlist

# ------------------------------------------------------------------------------
# 3. PRODUCTION SECRETS (Must be set via `wrangler secret put <NAME>`)
# ------------------------------------------------------------------------------
# DO NOT store these values in wrangler.toml or git repositories.
#
# Secret 1: CF_ACCESS_AUD
# The Application Audience Tag generated in Cloudflare Zero Trust Access Application.
# Provision command:
#   npx wrangler secret put CF_ACCESS_AUD
#
# Secret 2: CF_ACCESS_SECRET
# The HMAC/symmetric verification secret or public JWKS certificate for verifying Access JWTs.
# Provision command:
#   npx wrangler secret put CF_ACCESS_SECRET
#
# Secret 3: ADMIN_API_SECRET
# Fallback emergency administrative signing secret (minimum 32 random characters).
# Provision command:
#   npx wrangler secret put ADMIN_API_SECRET

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 STANDARD OBJECT STORAGE BINDING
# ------------------------------------------------------------------------------
# Configured declaratively in wrangler.toml as:
#   [[r2_buckets]]
#   binding = "PORTFOLIO_BUCKET"
#   bucket_name = "portfolio-data"
# Created via Cloudflare dashboard or:
#   npx wrangler r2 bucket create portfolio-data

